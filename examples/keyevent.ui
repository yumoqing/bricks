{
	"widgettype":"VBox",
	"options":{
		"overflow":"auto",
		"width":"100%",
		"height":"100%",
	},
	"binds":[
		{
			"wid":"app",
			"event":"keydown",
			"actiontype":"urlwidget",
			"target":"self",
			"mode":"append",
			"options":{
				"params":{},
				"url":"{{entire_url('./keytext.ui')}}"
			}
		}
	]
}
