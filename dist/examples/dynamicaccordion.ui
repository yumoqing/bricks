{
	"widgettype":"DynamicAccordion",
	"options":{
		"data_url":"{{entire_url('./channels.dspy')}}",
		"content_url":"{{entire_url('play_channel.dspy')}}",
		"content_view":{
			"id":"videoplayer",
			"widgettype":"Iframe",
			"options":{
				"width":"100%",
				"url":"${url}"
			}   
		},

		"record_view":{
			"widgettype":"HBox",
			"options":{
				"height":"100%",
				"width":"100%"
			},
			"subwidgets":[
				{
					"widgettype":"Icon",
					"options":{
						"rate":2,
						"url":"${logo_url}"
					}
				},
				{
					"widgettype":"Text",
					"options":{
						"text":"${title}"
					}
				}
			]
		},
		"page_rows":800,
		"cache_limit":5
	}
}
