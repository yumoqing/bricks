{
	"widgettype":"DynamicAccordion",
	"options":{
		"data_url":"{{entire_url('./channels.dspy')}}",
		"content_url":"{{entire_url('play_channel.dspy')}}",
		"content_view":{
			"widgettype":"VBox",
			"options":{
				"overflow":"auto",
				"width":"90%",
				"height":"500px"
			},
			"subwidgets":[
				{
					"id":"toolbar",
					"widgettype":"Toolbar",
					"options":{
						"orientation":"horizontal",
						"tool_margin":"15px",
						"tools":[
							{
								"name":"blocked",
								"label":"Blocked it"
							}
						]
					}
				},
				{
					"id":"videoplayer",
					"widgettype":"Video",
					"options":{
						"type":"application/x-mpegURL",
						"url":"${url}"
					}   
				}
			]
		},

		"record_view":{
			"widgettype":"HBox",
			"options":{
				"height":"100%",
				"width":"100%"
			},
			"subwidgets":[
				{
					"widgettype":"Icon",
					"options":{
						"rate":2,
						"url":"${logo_url}"
					}
				},
				{
					"widgettype":"Text",
					"options":{
						"text":"${title}"
					}
				}
			]
		},
		"page_rows":800,
		"cache_limit":5
	}
}
