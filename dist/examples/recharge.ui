{
	"widgettype":"IconbarPage",
	"options":{
		"bar_at":"top",
		"bar_opts":{
			"margin":"10px",
			"rate":1.6,
			"tools":[
				{
					"name":"wechat",
					"icon":"{{entire_url('/imgs/weixinzhifu.png')}}",
					"label":"微信充值",
					"tip":"使用微信为账户充值",
					"content":{
						"widgettype":"urlwidget",
						"options":{
							"url":"{{entire_url('wechat_recharge.ui')}}"
						}
					}
				},
				{
					"name":"alipay",
					"icon":"{{entire_url('/imgs/zhifubao.png')}}",
					"label":"支付宝充值",
					"tip":"使用支付宝为账户充值",
					"content":{
						"widgettype":"urlwidget",
						"options":{
							"url":"{{entire_url('alipay_recharge.ui')}}"
						}
					}
				}
			]
		}
	}
}
