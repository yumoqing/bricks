{
	"widgettype":"ChartPie",
	"options":{
		"width":"100%",
		"height":"100%",
		"title":"饼图测试",
		"description":"使用静态数据",
		"legend":{
			"top":"bottom"
		},
		"pie_options":{
			"name": "Access From",
			"type": "pie",
			"radius": ["40%", "70%"],
			"avoidLabelOverlap": false,
			"padAngle": 5,
			"itemStyle": {
				"borderRadius": 10
			},
			"label": {
				"show": false,
				"position": "center"
			},
			"emphasis": {
				"label": {
					"show": true,
					"fontSize": 40,
					"fontWeight": "bold"
				}
			},
			"labelLine": {
				"show": false
			}
	  	},
		"user_data":[
			{ value: 1048, name: 'Search Engine' },
			{ value: 735, name: 'Direct' },
			{ value: 580, name: 'Email' },
			{ value: 484, name: 'Union Ads' },
			{ value: 300, name: 'Video Ads' }
		]

	},
	"binds":[
		{
			"wid":"self",
			"event":"element_click",
			"actiontype":"script",
			"script":"console.log(params)"
		}
	]
}
