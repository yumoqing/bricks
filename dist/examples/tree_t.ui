{
	"widgettype":"VBox",
	"options":{
		"height":"100%",
		"width":"100%"
	},
	"subwidgets":[
		{
			"widgettype":"Title3",
			"options":{
				"height":"auto",
				"text":"This is a tree"
			}
		},
		{
            "widgettype":"Filler",
            "options":{},
            "subwidgets":[
                {
                    "widgettype":"urlwidget",
                    "options":{
                        "url":"{{entire_url('tree.ui')}}"
                    }
                }
            ]
        },
		{
			"widgettype":"Text",
			"options":{
				"height":"auto",
				"text":"This is footer message"
			}
		}
	]
}
